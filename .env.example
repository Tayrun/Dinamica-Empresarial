# Copia este archivo como .env solo para desarrollo local. No publiques .env.
# Usa una URL de inserción HTTPS generada por Power BI Service.
POWERBI_EMBED_URL=https://app.powerbi.com/view?r=REEMPLAZAR_CON_TOKEN

# Opcional: URL para abrir el informe fuera de la aplicación.
POWERBI_REPORT_URL=https://app.powerbi.com/view?r=REEMPLAZAR_CON_TOKEN
